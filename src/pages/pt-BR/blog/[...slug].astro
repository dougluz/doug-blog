---
import type { CollectionEntry } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import BackToPrev from "@components/BackToPrev.astro";
import LanguageSwitch from "@components/LanguageSwitch.astro";
import { getBlogContent, published } from "@lib/blog";
import { readingTime } from "@lib/utils";

export async function getStaticPaths() {
  const { englishPosts, portuguesePosts } = await getBlogContent();
  const publishedEnglishBySlug = new Map<string, CollectionEntry<"blog">>(
    published(englishPosts).map((post) => [post.slug, post] as const)
  );

  return published(portuguesePosts).map((post) => {
    const englishSlug = post.data.translationOf!;
    const englishPost = publishedEnglishBySlug.get(englishSlug);

    if (!englishPost) {
      throw new Error(
        `Published Portuguese post "${post.id}" has no published English source.`
      );
    }

    return {
      params: { slug: englishSlug },
      props: { post, englishPost },
    };
  });
}

type Props = {
  post: CollectionEntry<"blog">;
  englishPost: CollectionEntry<"blog">;
};

const { post, englishPost } = Astro.props;
const { Content } = await post.render();
const englishUrl = `/blog/${englishPost.slug}/`;
const portugueseUrl = `/pt-BR/blog/${englishPost.slug}/`;
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  locale="pt-BR"
  alternateUrls={{ en: englishUrl, "pt-BR": portugueseUrl }}
>
  <Container>
    <div class="animate flex flex-wrap items-center justify-between gap-3">
      <BackToPrev href="/blog">
        Voltar para o blog
      </BackToPrev>
      <LanguageSwitch
        href={englishUrl}
        locale="en"
        label="Read in English"
      />
    </div>
    <div class="my-10 space-y-1">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} locale="pt-BR" />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body, "pt-BR")}
        </div>
      </div>
      <div class="animate text-4xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
