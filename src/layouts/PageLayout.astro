---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import SpeedInsights from "@vercel/speed-insights/astro";

type Props = {
  title: string;
  description: string;
  image?: string;
  titleTemplate?: boolean;
  locale?: "en" | "pt-BR";
  alternateUrls?: {
    en: string;
    "pt-BR": string;
  };
  redirectToPortuguese?: string;
};

const {
  title,
  description,
  image,
  titleTemplate = true,
  locale = "en",
  alternateUrls,
  redirectToPortuguese,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <Head
      title={titleTemplate ? `${title} | ${SITE.NAME}` : title}
      description={description}
      image={image}
      locale={locale}
      alternateUrls={alternateUrls}
      redirectToPortuguese={redirectToPortuguese}
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <SpeedInsights />
  </body>
</html>
