---
interface Props {
  date: Date;
  locale?: "en" | "pt-BR";
}

const { date, locale = "en" } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(locale === "pt-BR" ? "pt-BR" : "en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  }
</time>
